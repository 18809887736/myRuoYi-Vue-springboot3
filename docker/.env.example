# 镜像 tag
MYSQL_TAG=8.0
REDIS_TAG=7-alpine
NGINX_TAG=1.27-alpine
NODE_TAG=20-alpine

# 宿主机端口(对外只暴露这两个)
HOST_PORT_FRONTEND=18080
HOST_PORT_BACKEND=18081

# MySQL
MYSQL_ROOT_PASSWORD=ChangeMe_RootPwd
MYSQL_DATABASE=ry-vue
MYSQL_USER=ruoyi
MYSQL_PASSWORD=ChangeMe_RuoyiPwd

# Redis
REDIS_PASSWORD=ChangeMe_RedisPwd

# 后端
BACKEND_PORT=18080
JVM_OPTS=-Xms256m -Xmx1024m
UPLOAD_PATH=/home/ruoyi/uploadPath
# JWT 密钥(原默认 abcdefghijklmnopqrstuvwxyz, 必须替换), 建议 64 位随机 hex
TOKEN_SECRET=ChangeMe_64chars_random_hex
